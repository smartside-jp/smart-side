---
// smart-side 共通レイアウト
// SEO・OGP・構造化データ（JSON-LD）・フォント・グローバルスタイルを集約
// 4条件①匿名遵守：地域情報・本名・実所属を出さない

// フォントセルフホスト（fontsource パッケージ）
import '@fontsource/instrument-serif/400.css';
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/700.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/noto-sans-jp/400.css';
import '@fontsource/noto-sans-jp/700.css';
import '@fontsource/noto-serif-jp/700.css';

// グローバルスタイル
import '../styles/global.css';

// 共通コンポーネント
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// 記事ページ用のメタ情報（あれば og:type=article 化 + Article JSON-LD 出力）
export interface ArticleMeta {
  publishedTime: Date;     // article:published_time / Article.datePublished
  modifiedTime?: Date;     // article:modified_time / Article.dateModified
  section: string;         // article:section / Article.articleSection（カテゴリ表示名）
  tags: string[];          // article:tag / Article.keywords
  authorName?: string;     // 4条件①で匿名運用 → デフォルトは "smart-side editorial"
}

// パンくず用（指定があれば BreadcrumbList JSON-LD 出力）
export interface BreadcrumbItem {
  name: string;
  url: string; // フルURL or 絶対パス（後で Astro.site と結合）
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: ArticleMeta;
  breadcrumb?: BreadcrumbItem[];
}

const SITE_NAME = 'smart-side';
const SITE_TAGLINE = '非エンジニアの最低限スターターキット';
const DEFAULT_TITLE = `smart-side ─ 非エンジニアの最低限スターターキット | AI・投資・IT`;
const DEFAULT_DESCRIPTION = '世のテンプレを全部試して、本当に要るものだけ残しました。AI・投資・ITの最低限スターターキット。非エンジニア視点で。';
const DEFAULT_OG_IMAGE = '/og-default.png';
const AUTHOR_NAME = 'smart-side editorial';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
  article,
  breadcrumb,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site).toString();
const ogType = article ? 'article' : 'website';

// 全ページ共通：WebSite + Organization JSON-LD
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  alternateName: SITE_TAGLINE,
  url: Astro.site?.toString() ?? 'https://smart-side.dev/',
  description: DEFAULT_DESCRIPTION,
  inLanguage: 'ja-JP',
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: Astro.site?.toString() ?? 'https://smart-side.dev/',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/og-default.png', Astro.site).toString(),
    },
  },
};

// 記事ページ専用：Article JSON-LD
const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: description,
      image: [ogImageURL],
      datePublished: article.publishedTime.toISOString(),
      dateModified: (article.modifiedTime ?? article.publishedTime).toISOString(),
      author: {
        '@type': 'Organization',
        name: article.authorName ?? AUTHOR_NAME,
        url: Astro.site?.toString() ?? 'https://smart-side.dev/',
      },
      publisher: {
        '@type': 'Organization',
        name: SITE_NAME,
        logo: {
          '@type': 'ImageObject',
          url: new URL('/og-default.png', Astro.site).toString(),
        },
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.toString(),
      },
      articleSection: article.section,
      keywords: article.tags.join(', '),
      inLanguage: 'ja-JP',
    }
  : null;

// パンくず JSON-LD（breadcrumb 指定があれば）
const breadcrumbSchema =
  breadcrumb && breadcrumb.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumb.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: b.url.startsWith('http') ? b.url : new URL(b.url, Astro.site).toString(),
        })),
      }
    : null;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="ja_JP" />

    {/* 記事ページのみ：article 名前空間メタ */}
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime.toISOString()} />
        {article.modifiedTime && (
          <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
        )}
        <meta property="article:section" content={article.section} />
        {article.tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
        <meta property="article:author" content={article.authorName ?? AUTHOR_NAME} />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="smart-side" href="/rss.xml" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* 構造化データ（JSON-LD） */}
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- Cloudflare Web Analytics（Cookieless・同意バナー不要） -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "a5d586563d2842879a0955a95fe405f9"}'></script>
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
