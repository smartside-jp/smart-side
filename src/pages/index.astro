---
// smart-side トップページ（misclog 構造踏襲）
// 4条件①匿名遵守：地域情報・本名・実所属・偽ペンネーム・偽数値を出さない
// データソース：Astro Content Collection 'posts'（schema: src/content.config.ts）

import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../lib/categories';

// ──────────── データ取得・派生 ────────────
type Post = CollectionEntry<'posts'>;

const allPosts = await getCollection('posts', ({ data }) => !data.draft);

const byPublishedDesc = (a: Post, b: Post) =>
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime();

// 新着4件
const newPosts = [...allPosts].sort(byPublishedDesc).slice(0, 4);

// Popular（popularRank 昇順・最大5件）
const popular = allPosts
  .filter((p) => typeof p.data.popularRank === 'number')
  .sort((a, b) => (a.data.popularRank! - b.data.popularRank!))
  .slice(0, 5);

// Recommend（編集部おすすめ・最大3件・featured 優先）
const recommend = allPosts
  .filter((p) => p.data.pickedByEditor)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || byPublishedDesc(a, b))
  .slice(0, 3);

// カテゴリ別 4件ずつ
const filterByCategory = (slug: 'ai' | 'invest' | 'it') =>
  allPosts.filter((p) => p.data.category === slug).sort(byPublishedDesc).slice(0, 4);

const categoryAI = filterByCategory('ai');
const categoryInvest = filterByCategory('invest');
const categoryIT = filterByCategory('it');

// インデックス（カテゴリ件数表示）
const indexCategories = [
  { href: '/category/ai', label: CATEGORIES.ai.fullLabel, count: allPosts.filter((p) => p.data.category === 'ai').length },
  { href: '/category/invest', label: CATEGORIES.invest.fullLabel, count: allPosts.filter((p) => p.data.category === 'invest').length },
  { href: '/category/it', label: CATEGORIES.it.fullLabel, count: allPosts.filter((p) => p.data.category === 'it').length },
  { href: '/starter-kit', label: CATEGORIES['starter-kit'].fullLabel, count: allPosts.filter((p) => p.data.category === 'starter-kit').length },
  { href: '/category/editorial', label: CATEGORIES.editorial.fullLabel, count: allPosts.filter((p) => p.data.category === 'editorial').length },
  { href: '/about', label: 'About', count: 0 },
];

// 日付フォーマット
const formatDate = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}.${m}.${day}`;
};

// カテゴリ slug → ラベル（カード上の表示用）
const categoryLabel = (slug: Post['data']['category']) => CATEGORIES[slug].label;

// アクセント未指定のフォールバック
const fallbackAccent = 'from-zinc-200 to-zinc-400';
---

<BaseLayout>
  {/* ─────────── HERO（左テキスト + 右画像 2カラム / 雑誌風） ─────────── */}
  <section class="max-w-7xl mx-auto px-6 md:px-12 pt-16 md:pt-24 pb-20 md:pb-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      {/* 左ペイン：テキスト + 2 CTA */}
      <div class="lg:col-span-6 order-2 lg:order-1">
        <p class="meta text-xs mb-8">— Issue 001 — Spring 2026</p>
        <h1
          class="text-4xl sm:text-5xl md:text-6xl leading-tight mb-8"
          style="font-family: var(--font-jp-serif); font-weight: 700;"
        >
          「要らない9割」を<br class="sm:hidden"/>捨てる<br/>最低限<br class="sm:hidden"/>スターターキット
        </h1>
        <p
          class="text-base md:text-lg leading-relaxed mb-10"
          style="color: var(--color-fg-muted); font-family: var(--font-jp-sans);"
        >
          AI・投資・IT。世のテンプレを全部試して、削った先に残ったものだけ。<br/>
          非エンジニアが書く、ミニマム実装メディア。
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/starter-kit"
            class="inline-flex items-center px-6 py-3 text-sm hover:opacity-80 transition-opacity"
            style="background-color: var(--color-fg); color: var(--color-fg-inverse); font-family: var(--font-jp-sans);"
          >
            スターターキットを読む →
          </a>
          <a
            href="/archive"
            class="inline-flex items-center px-6 py-3 text-sm border hover:bg-black/5 transition-colors"
            style="border-color: var(--color-fg); color: var(--color-fg); font-family: var(--font-jp-sans);"
          >
            運用ログを見る →
          </a>
        </div>
      </div>

      {/* 右ペイン：ヒーロー画像（仮 placeholder・本番画像到着で差し替え） */}
      <div class="lg:col-span-6 order-1 lg:order-2">
        <div
          class="aspect-[5/4] w-full overflow-hidden"
          style="background: linear-gradient(135deg, #F0EBE0 0%, #DBD0BC 50%, #B8A88E 100%);"
        >
          <div class="w-full h-full flex items-center justify-center">
            <div class="text-center px-6">
              <p class="text-xs tracking-[0.2em] uppercase mb-4" style="color: rgba(0,0,0,0.4); font-family: var(--font-mono);">
                Hero Image
              </p>
              <p class="text-sm" style="color: rgba(0,0,0,0.5); font-family: var(--font-jp-serif);">
                placeholder ─ 本番画像到着で差し替え
              </p>
              <p class="text-[10px] mt-6 tracking-wide" style="color: rgba(0,0,0,0.3); font-family: var(--font-mono);">
                /images/hero-collection.png
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── NEW POSTS（4列） ─────────── */}
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20 border-t" style="border-color: rgba(10,10,10,0.08);">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="meta text-xs mb-2">— New Posts</p>
        <h2 class="text-2xl md:text-3xl" style="font-family: var(--font-jp-serif); font-weight: 700;">新着記事</h2>
      </div>
      <a href="/archive" class="text-xs hover:underline underline-offset-4" style="font-family: var(--font-mono); letter-spacing: 0.05em;">
        VIEW ALL →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-12">
      {newPosts.map((p) => (
        <a href={`/posts/${p.id}`} class="group block">
          {p.data.heroImage ? (
            <img
              src={p.data.heroImage}
              alt={p.data.title}
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] mb-4 w-full object-cover"
            />
          ) : (
            <div class={`aspect-[4/3] mb-4 overflow-hidden bg-gradient-to-br ${p.data.accent ?? fallbackAccent}`}>
              <div class="w-full h-full flex items-end p-4">
                <span class="text-[10px] tracking-widest uppercase text-white/80" style="font-family: var(--font-mono);">
                  {categoryLabel(p.data.category)}
                </span>
              </div>
            </div>
          )}
          <p class="meta text-[10px] mb-2">
            {formatDate(p.data.publishedAt)}{p.data.readTime ? ` · ${p.data.readTime}` : ''}
          </p>
          <h3 class="text-base md:text-lg leading-snug group-hover:underline underline-offset-4" style="font-family: var(--font-jp-serif); font-weight: 700;">
            {p.data.title}
          </h3>
        </a>
      ))}
    </div>
  </section>

  {/* ─────────── POPULAR + RECOMMEND（2カラム） ─────────── */}
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20 border-t" style="border-color: rgba(10,10,10,0.08);">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      {/* POPULAR */}
      <div class="lg:col-span-5">
        <p class="meta text-xs mb-2">— Popular</p>
        <h2 class="text-2xl md:text-3xl mb-8" style="font-family: var(--font-jp-serif); font-weight: 700;">よく読まれている</h2>
        <ol class="space-y-6">
          {popular.map((p, i) => (
            <li>
              <a href={`/posts/${p.id}`} class="group flex gap-5 items-baseline">
                <span class="text-3xl shrink-0 w-10 leading-none" style="font-family: var(--font-display); color: var(--color-fg-muted);">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <p class="meta text-[10px] mb-1">{categoryLabel(p.data.category)}</p>
                  <p class="text-sm md:text-base leading-snug group-hover:underline underline-offset-4" style="font-family: var(--font-jp-sans); font-weight: 500;">
                    {p.data.title}
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </div>

      {/* RECOMMEND */}
      <div class="lg:col-span-7">
        <p class="meta text-xs mb-2">— Editor's Pick</p>
        <h2 class="text-2xl md:text-3xl mb-8" style="font-family: var(--font-jp-serif); font-weight: 700;">編集部おすすめ</h2>
        <div class="space-y-8">
          {recommend.map((r) => (
            <a href={`/posts/${r.id}`} class="group grid grid-cols-3 gap-5 items-start">
              {r.data.heroImage ? (
                <img
                  src={r.data.heroImage}
                  alt={r.data.title}
                  loading="lazy"
                  decoding="async"
                  class="col-span-1 aspect-[4/3] w-full object-cover"
                />
              ) : (
                <div class={`col-span-1 aspect-[4/3] bg-gradient-to-br ${r.data.accent ?? fallbackAccent}`}></div>
              )}
              <div class="col-span-2">
                <p class="meta text-[10px] mb-2">{categoryLabel(r.data.category)}</p>
                <h3 class="text-base md:text-lg leading-snug mb-2 group-hover:underline underline-offset-4" style="font-family: var(--font-jp-serif); font-weight: 700;">
                  {r.data.title}
                </h3>
                <p class="text-xs md:text-sm leading-relaxed" style="color: var(--color-fg-muted); font-family: var(--font-jp-sans);">
                  {r.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── CATEGORY: AI ─────────── */}
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20 border-t" style="border-color: rgba(10,10,10,0.08);">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="meta text-xs mb-2">— Category 01</p>
        <h2 class="text-2xl md:text-3xl" style="font-family: var(--font-jp-serif); font-weight: 700;">{CATEGORIES.ai.fullLabel}</h2>
      </div>
      <a href="/category/ai" class="text-xs hover:underline underline-offset-4" style="font-family: var(--font-mono); letter-spacing: 0.05em;">
        VIEW ALL →
      </a>
    </div>
    <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">
      {categoryAI.map((p) => (
        <li>
          <a href={`/posts/${p.id}`} class="group block py-3 border-b" style="border-color: rgba(10,10,10,0.08);">
            <p class="meta text-[10px] mb-2">{formatDate(p.data.publishedAt)}</p>
            <h3 class="text-base leading-snug group-hover:underline underline-offset-4" style="font-family: var(--font-jp-serif); font-weight: 700;">
              {p.data.title}
            </h3>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ─────────── CATEGORY: 投資 ─────────── */}
  <section class="py-16 md:py-20" style="background-color: var(--color-bg-section);">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="meta text-xs mb-2">— Category 02</p>
          <h2 class="text-2xl md:text-3xl" style="font-family: var(--font-jp-serif); font-weight: 700;">{CATEGORIES.invest.fullLabel}</h2>
        </div>
        <a href="/category/invest" class="text-xs hover:underline underline-offset-4" style="font-family: var(--font-mono); letter-spacing: 0.05em;">
          VIEW ALL →
        </a>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">
        {categoryInvest.map((p) => (
          <li>
            <a href={`/posts/${p.id}`} class="group block py-3 border-b" style="border-color: rgba(10,10,10,0.08);">
              <p class="meta text-[10px] mb-2">{formatDate(p.data.publishedAt)}</p>
              <h3 class="text-base leading-snug group-hover:underline underline-offset-4" style="font-family: var(--font-jp-serif); font-weight: 700;">
                {p.data.title}
              </h3>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ─────────── CATEGORY: IT ─────────── */}
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20 border-t" style="border-color: rgba(10,10,10,0.08);">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="meta text-xs mb-2">— Category 03</p>
        <h2 class="text-2xl md:text-3xl" style="font-family: var(--font-jp-serif); font-weight: 700;">{CATEGORIES.it.fullLabel}</h2>
      </div>
      <a href="/category/it" class="text-xs hover:underline underline-offset-4" style="font-family: var(--font-mono); letter-spacing: 0.05em;">
        VIEW ALL →
      </a>
    </div>
    <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">
      {categoryIT.map((p) => (
        <li>
          <a href={`/posts/${p.id}`} class="group block py-3 border-b" style="border-color: rgba(10,10,10,0.08);">
            <p class="meta text-[10px] mb-2">{formatDate(p.data.publishedAt)}</p>
            <h3 class="text-base leading-snug group-hover:underline underline-offset-4" style="font-family: var(--font-jp-serif); font-weight: 700;">
              {p.data.title}
            </h3>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* ─────────── STARTER KIT CTA（黒背景フルブリード） ─────────── */}
  <section style="background-color: var(--color-bg-dark); color: var(--color-fg-inverse);">
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-20 md:py-28">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-center">
        <div class="md:col-span-7">
          <p class="text-xs mb-5 opacity-60" style="font-family: var(--font-mono); letter-spacing: 0.1em;">— STARTER KIT</p>
          <h2 class="text-3xl md:text-5xl leading-tight mb-6" style="font-family: var(--font-jp-serif); font-weight: 700;">
            最低限の<br/>スターターキット
          </h2>
          <p class="text-sm md:text-base leading-relaxed opacity-80 max-w-xl" style="font-family: var(--font-jp-sans);">
            AI、投資、ITの「これだけは外せない」を、非エンジニア視点で一冊にまとめた読み物。<br/>
            テンプレ集ではなく、削った先に残ったものだけ。
          </p>
        </div>
        <div class="md:col-span-5 md:text-right">
          <a
            href="/starter-kit"
            class="inline-flex items-center px-7 py-4 text-sm hover:opacity-80 transition-opacity"
            style="background-color: var(--color-fg-inverse); color: var(--color-fg); font-family: var(--font-jp-sans);"
          >
            読み始める →
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── INDEX（ディレクトリ） ─────────── */}
  <section class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20">
    <div class="mb-10">
      <p class="meta text-xs mb-2">— Index</p>
      <h2 class="text-2xl md:text-3xl" style="font-family: var(--font-jp-serif); font-weight: 700;">目次</h2>
    </div>
    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10">
      {indexCategories.map((c) => (
        <li>
          <a
            href={c.href}
            class="group flex items-baseline justify-between py-5 border-b hover:opacity-70 transition-opacity"
            style="border-color: rgba(10,10,10,0.12);"
          >
            <span class="text-base md:text-lg" style="font-family: var(--font-jp-serif); font-weight: 700;">
              {c.label}
            </span>
            <span class="meta text-[10px]">
              {c.count > 0 ? `${c.count} ARTICLES` : '— ARTICLES'}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
