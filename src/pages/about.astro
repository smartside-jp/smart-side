---
// /about ─ お問い合わせ + カテゴリ案内
// 4条件①匿名遵守：地域情報・本名・実所属を出さない
// Contact は Google フォームで受付（mailto 廃止）。ルート /about は維持
//（健康診断アプリの「プロに相談する」導線 CONSULT_URL が smart-side.dev/about を指すため）

import BaseLayout from '../layouts/BaseLayout.astro';

// 回答用（公開）URL。編集用 /edit ではなく /viewform を使う
const FORM_URL = 'https://docs.google.com/forms/d/1MnwTK_wJnXiAmsmQb_66w1H_fAtZfZhVOtZoO3bg0qA/viewform';
---

<BaseLayout
  title="お問い合わせ | smart-side"
  description="smart-side へのご感想・取り上げてほしいテーマ・誤りの指摘、資産形成の個別のご相談は、お問い合わせフォームからお気軽にどうぞ。"
>
  {/* ─────────── CONTACT（ページヒーロー） ─────────── */}
  <section class="max-w-4xl mx-auto px-6 md:px-12 pt-24 md:pt-32 pb-16 md:pb-20">
    <p class="meta text-xs mb-6">— Contact</p>
    <h1
      class="text-4xl md:text-6xl leading-tight mb-8"
      style="font-family: var(--font-jp-serif); font-weight: 700;"
    >
      お問い合わせ
    </h1>
    <p class="text-base md:text-lg leading-relaxed mb-10 max-w-2xl" style="color: var(--color-fg-muted); font-family: var(--font-jp-sans);">
      記事への感想・取り上げてほしいテーマ・誤りの指摘、そして「資産形成について個別に相談したい」といったご連絡を、フォームでお受けしています。<br/>
      個別の返信はお約束していませんが、いただいた声は編集の参考にさせていただきます。<strong style="color: var(--color-fg);">ニックネームでの送信（実名不要）でOK</strong>です。
    </p>
    <a
      href={FORM_URL}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center px-7 py-4 text-sm md:text-base font-bold hover:opacity-85 transition-opacity"
      style="background-color: var(--color-accent); color: #ffffff; font-family: var(--font-jp-sans);"
    >
      お問い合わせフォームを開く →
    </a>
    <p class="text-xs mt-3" style="color: var(--color-fg-muted);">
      ログイン不要・実名不要／別タブで開きます
    </p>
  </section>

  {/* ─────────── 3カテゴリ ─────────── */}
  <section class="max-w-4xl mx-auto px-6 md:px-12 py-16 md:py-24 border-t" style="border-color: rgba(10,10,10,0.08);">
    <p class="meta text-xs mb-10">— Categories</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <p class="text-xs mb-2" style="font-family: var(--font-mono); letter-spacing: 0.1em; color: var(--color-fg-muted);">— AI</p>
        <h3 class="text-xl mb-3" style="font-family: var(--font-jp-serif); font-weight: 700;">AI / 人工知能</h3>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted); font-family: var(--font-jp-sans);">
          Claude / ChatGPT / MCP / プロンプト。非エンジニアが業務で使うラインまで削った話。
        </p>
      </div>
      <div>
        <p class="text-xs mb-2" style="font-family: var(--font-mono); letter-spacing: 0.1em; color: var(--color-fg-muted);">— INVEST</p>
        <h3 class="text-xl mb-3" style="font-family: var(--font-jp-serif); font-weight: 700;">投資 / お金</h3>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted); font-family: var(--font-jp-sans);">
          新NISA / iDeCo / インデックス。世のテンプレを試して残ったものだけ。
        </p>
      </div>
      <div>
        <p class="text-xs mb-2" style="font-family: var(--font-mono); letter-spacing: 0.1em; color: var(--color-fg-muted);">— IT</p>
        <h3 class="text-xl mb-3" style="font-family: var(--font-jp-serif); font-weight: 700;">IT / 道具</h3>
        <p class="text-sm leading-relaxed" style="color: var(--color-fg-muted); font-family: var(--font-jp-sans);">
          パスワード管理 / 2FA / バックアップ。最低限の道具と運用。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
