---
// 用語集ページ（Lv1.5 glossary 一覧）
// サムネなし統一・行リスト形式・カテゴリでセクション分け

import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../lib/categories';

type Post = CollectionEntry<'posts'>;

const allPosts = await getCollection('posts', ({ data }) => !data.draft);

// glossary レベルだけ抽出
const glossaryPosts = allPosts
  .filter((p) => p.data.level === 'glossary')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// カテゴリ別にグループ化
const grouped: Record<string, Post[]> = {};
for (const p of glossaryPosts) {
  const cat = p.data.category;
  if (!grouped[cat]) grouped[cat] = [];
  grouped[cat].push(p);
}

const categoryOrder: Array<keyof typeof CATEGORIES> = ['invest', 'ai', 'it', 'starter-kit', 'editorial'];
const categoriesWithPosts = categoryOrder.filter((slug) => grouped[slug]?.length > 0);

const formatDate = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}.${m}.${day}`;
};
---

<BaseLayout
  title="用語集 | smart-side"
  description="smart-side の用語解説シリーズ。1用語1記事・薄く深く。NISA / インデックス / 2FA など、初心者がつまずく1点だけを解説。"
>
  {/* ─────────── HERO ─────────── */}
  <section class="max-w-7xl mx-auto px-6 md:px-12 pt-12 md:pt-20 pb-12 md:pb-16">
    {/* パンくず */}
    <nav class="meta text-[10px] mb-8" aria-label="パンくず">
      <a href="/" class="hover:underline underline-offset-4">HOME</a>
      <span class="mx-2 opacity-50">/</span>
      <span class="opacity-70">用語集</span>
    </nav>

    <p class="meta text-xs mb-4">— Glossary</p>
    <h1
      class="text-4xl md:text-6xl leading-tight mb-6"
      style="font-family: var(--font-jp-serif); font-weight: 700;"
    >
      用語集
    </h1>
    <p class="text-base md:text-lg leading-relaxed max-w-2xl" style="color: var(--color-fg-muted); font-family: var(--font-jp-sans);">
      AI・投資・IT で出てくる用語を、1語ずつ「初心者がつまずく1点」だけ解説。
      ググれば出る完璧な定義じゃなく、**今日から動けるショートカット**として。
    </p>
    <p class="meta text-[10px] mt-6">
      {glossaryPosts.length > 0 ? `${glossaryPosts.length} TERMS` : '— TERMS'}
    </p>
  </section>

  {/* ─────────── GLOSSARY LIST ─────────── */}
  <section class="max-w-3xl mx-auto px-6 md:px-12 pb-16 md:pb-24 border-t" style="border-color: rgba(10,10,10,0.08);">
    {glossaryPosts.length === 0 ? (
      <div class="py-20 text-center">
        <p class="text-base md:text-lg" style="color: var(--color-fg-muted); font-family: var(--font-jp-sans);">
          まだ用語が登録されていません。
        </p>
      </div>
    ) : (
      <div class="pt-12 md:pt-16">
        {categoriesWithPosts.map((catSlug) => (
          <div class="mb-12">
            <h2
              class="text-xl md:text-2xl mb-6 pb-3 border-b"
              style="border-color: rgba(10,10,10,0.12); font-family: var(--font-jp-serif); font-weight: 700;"
            >
              {CATEGORIES[catSlug].fullLabel}
            </h2>
            <ul class="space-y-4">
              {grouped[catSlug].map((p) => (
                <li>
                  <a
                    href={`/posts/${p.id}`}
                    class="group block py-3 hover:bg-black/[0.02] transition-colors -mx-2 px-2 rounded"
                  >
                    <div class="flex items-baseline gap-3 flex-wrap">
                      <h3
                        class="text-base md:text-lg leading-snug group-hover:underline underline-offset-4"
                        style="font-family: var(--font-jp-serif); font-weight: 700;"
                      >
                        {p.data.title}
                      </h3>
                      <p class="meta text-[10px]" style="color: var(--color-fg-muted);">
                        {formatDate(p.data.publishedAt)}{p.data.readTime ? ` · ${p.data.readTime}` : ''}
                      </p>
                    </div>
                    {p.data.description && (
                      <p
                        class="text-xs md:text-sm leading-relaxed mt-1 line-clamp-2"
                        style="color: var(--color-fg-muted); font-family: var(--font-jp-sans);"
                      >
                        {p.data.description}
                      </p>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
