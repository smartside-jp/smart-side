---
// 404 ページ
// dist/404.html として生成・存在しないパス表示時に GitHub Pages が返す
// 4条件①匿名遵守：地域情報・本名・実所属を出さない

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const latest = [...posts]
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const formatDate = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}.${m}.${day}`;
};

const fallbackAccent = 'from-zinc-200 to-zinc-400';
---

<BaseLayout
  title="404 — Page not found | smart-side"
  description="お探しのページは見つかりませんでした。"
>
  <section class="max-w-5xl mx-auto px-6 md:px-12 pt-24 md:pt-32 pb-16 md:pb-20">
    <p class="meta text-xs mb-6">— Error 404</p>
    <h1
      class="text-5xl md:text-7xl leading-tight mb-8"
      style="font-family: var(--font-display); font-weight: 400;"
    >
      404
    </h1>
    <p
      class="text-base md:text-lg leading-relaxed max-w-2xl mb-10"
      style="color: var(--color-fg-muted); font-family: var(--font-jp-sans);"
    >
      お探しのページは見つかりませんでした。<br/>
      URL の変更・記事の取り下げ・タイポなどが考えられます。
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href="/"
        class="inline-flex items-center px-6 py-3 text-sm hover:opacity-80 transition-opacity"
        style="background-color: var(--color-fg); color: var(--color-fg-inverse); font-family: var(--font-jp-sans);"
      >
        トップに戻る →
      </a>
      <a
        href="/starter-kit"
        class="inline-flex items-center px-6 py-3 text-sm border hover:bg-black/5 transition-colors"
        style="border-color: var(--color-fg); color: var(--color-fg); font-family: var(--font-jp-sans);"
      >
        スターターキットを読む →
      </a>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20 border-t" style="border-color: rgba(10,10,10,0.08);">
      <div class="mb-10">
        <p class="meta text-xs mb-2">— Recent</p>
        <h2 class="text-2xl md:text-3xl" style="font-family: var(--font-jp-serif); font-weight: 700;">
          最近の記事から
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-10">
        {latest.map((p) => (
          <a href={`/posts/${p.id}`} class="group block">
            {p.data.heroImage ? (
              <img
                src={p.data.heroImage}
                alt={p.data.title}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] mb-4 w-full object-cover"
              />
            ) : (
              <div class={`aspect-[4/3] mb-4 bg-gradient-to-br ${p.data.accent ?? fallbackAccent}`}></div>
            )}
            <p class="meta text-[10px] mb-2">{formatDate(p.data.publishedAt)}</p>
            <h3 class="text-base leading-snug group-hover:underline underline-offset-4" style="font-family: var(--font-jp-serif); font-weight: 700;">
              {p.data.title}
            </h3>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
