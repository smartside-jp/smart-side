---
// /starter-kit ─ スターターキット ランディング
// starter-kit カテゴリの記事を集めて表示する単独ページ
// 4条件①匿名遵守：地域情報・本名・実所属を出さない

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const starterKitPosts = allPosts
  .filter((p) => p.data.category === 'starter-kit')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const featured = starterKitPosts.find((p) => p.data.featured) ?? starterKitPosts[0];
const others = starterKitPosts.filter((p) => p.id !== featured?.id);

// 関連カテゴリ各3件
const aiTop = allPosts
  .filter((p) => p.data.category === 'ai')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
const investTop = allPosts
  .filter((p) => p.data.category === 'invest')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
const itTop = allPosts
  .filter((p) => p.data.category === 'it')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const formatDate = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}.${m}.${day}`;
};

const fallbackAccent = 'from-zinc-200 to-zinc-400';
---

<BaseLayout
  title="スターターキット | smart-side"
  description="AI・投資・IT、それぞれの「これだけは外せない」を非エンジニア視点でまとめた最低限スターターキット。"
>
  {/* ─────────── HERO（黒背景フルブリード） ─────────── */}
  <section style="background-color: var(--color-bg-dark); color: var(--color-fg-inverse);">
    <div class="max-w-7xl mx-auto px-6 md:px-12 pt-24 md:pt-32 pb-20 md:pb-28">
      <p class="text-xs mb-6 opacity-60" style="font-family: var(--font-mono); letter-spacing: 0.1em;">— STARTER KIT</p>
      <h1
        class="text-4xl md:text-6xl lg:text-7xl leading-tight mb-8 max-w-4xl"
        style="font-family: var(--font-jp-serif); font-weight: 700;"
      >
        「要らない9割」を<br class="sm:hidden"/>捨てる<br/>最低限<br class="sm:hidden"/>スターターキット
      </h1>
      <p class="text-base md:text-lg leading-relaxed max-w-2xl opacity-80" style="font-family: var(--font-jp-sans);">
        AI・投資・IT、それぞれの「これだけは外せない」を非エンジニア視点で1ページにまとめた読み物。<br/>
        テンプレ集ではなく、削った先に残ったものだけ。
      </p>
    </div>
  </section>

  {/* ─────────── FEATURED ─────────── */}
  {featured && (
    <section class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-24">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
        <div class="md:col-span-6">
          {featured.data.heroImage ? (
            <img
              src={featured.data.heroImage}
              alt={featured.data.title}
              width="1672"
              height="941"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full object-cover"
            />
          ) : (
            <div class={`aspect-[4/3] bg-gradient-to-br ${featured.data.accent ?? fallbackAccent}`}></div>
          )}
        </div>
        <div class="md:col-span-6">
          <p class="meta text-xs mb-4">— Featured</p>
          <h2
            class="text-2xl md:text-4xl leading-tight mb-6"
            style="font-family: var(--font-jp-serif); font-weight: 700;"
          >
            <a href={`/posts/${featured.id}`} class="hover:underline underline-offset-4">
              {featured.data.title}
            </a>
          </h2>
          {featured.data.description && (
            <p class="text-base leading-relaxed mb-6" style="color: var(--color-fg-muted); font-family: var(--font-jp-sans);">
              {featured.data.description}
            </p>
          )}
          <p class="meta text-[10px] mb-6">
            {formatDate(featured.data.publishedAt)}{featured.data.readTime ? ` · ${featured.data.readTime}` : ''}
          </p>
          <a
            href={`/posts/${featured.id}`}
            class="inline-flex items-center px-6 py-3 text-sm hover:opacity-80 transition-opacity"
            style="background-color: var(--color-fg); color: var(--color-fg-inverse); font-family: var(--font-jp-sans);"
          >
            読み始める →
          </a>
        </div>
      </div>
    </section>
  )}

  {/* ─────────── 3カテゴリの厳選コンテンツ ─────────── */}
  <section class="border-t" style="background-color: var(--color-bg-section); border-color: rgba(10,10,10,0.08);">
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-24">
      <div class="mb-12">
        <p class="meta text-xs mb-2">— Three Pillars</p>
        <h2 class="text-2xl md:text-3xl" style="font-family: var(--font-jp-serif); font-weight: 700;">3つの柱 ／ それぞれの最低限</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
        {[
          { title: 'AI', subtitle: '人工知能', posts: aiTop, href: '/category/ai' },
          { title: '投資', subtitle: 'お金', posts: investTop, href: '/category/invest' },
          { title: 'IT', subtitle: '道具', posts: itTop, href: '/category/it' },
        ].map((pillar) => (
          <div>
            <p class="text-xs mb-2" style="font-family: var(--font-mono); letter-spacing: 0.1em; color: var(--color-fg-muted);">— {pillar.title}</p>
            <h3 class="text-2xl mb-6" style="font-family: var(--font-jp-serif); font-weight: 700;">
              {pillar.title} <span class="text-base" style="color: var(--color-fg-muted);">／ {pillar.subtitle}</span>
            </h3>
            <ul class="space-y-4 mb-6">
              {pillar.posts.map((p) => (
                <li>
                  <a href={`/posts/${p.id}`} class="group block py-2 border-b" style="border-color: rgba(10,10,10,0.08);">
                    <p class="meta text-[10px] mb-1">{formatDate(p.data.publishedAt)}</p>
                    <p class="text-sm leading-snug group-hover:underline underline-offset-4" style="font-family: var(--font-jp-serif); font-weight: 700;">
                      {p.data.title}
                    </p>
                  </a>
                </li>
              ))}
            </ul>
            <a href={pillar.href} class="text-xs hover:underline underline-offset-4" style="font-family: var(--font-mono); letter-spacing: 0.05em;">
              {pillar.title} の記事一覧 →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ─────────── その他のスターターキット記事（複数ある場合） ─────────── */}
  {others.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-24 border-t" style="border-color: rgba(10,10,10,0.08);">
      <div class="mb-10">
        <p class="meta text-xs mb-2">— More from Starter Kit</p>
        <h2 class="text-2xl md:text-3xl" style="font-family: var(--font-jp-serif); font-weight: 700;">スターターキット 関連記事</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-12">
        {others.map((p) => (
          <a href={`/posts/${p.id}`} class="group block">
            {p.data.heroImage ? (
              <img
                src={p.data.heroImage}
                alt={p.data.title}
                width="1672"
                height="941"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] mb-4 w-full object-cover"
              />
            ) : (
              <div class={`aspect-[4/3] mb-4 bg-gradient-to-br ${p.data.accent ?? fallbackAccent}`}></div>
            )}
            <p class="meta text-[10px] mb-2">{formatDate(p.data.publishedAt)}</p>
            <h3 class="text-base leading-snug group-hover:underline underline-offset-4" style="font-family: var(--font-jp-serif); font-weight: 700;">
              {p.data.title}
            </h3>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
